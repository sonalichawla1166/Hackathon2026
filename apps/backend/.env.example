# Copy to apps/backend/.env and fill in. .env is gitignored.
# Without AZURE_OPENAI_ENDPOINT/AZURE_OPENAI_KEY, /chat still works: it falls
# back to retrieval-only (returns a real citation + passage, no LLM narration).

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

SARVAM_API_KEY=

# Azure *deployment* names (not raw model names) — must match what you named
# the deployment in Azure OpenAI Studio.
CHAT_MODEL=gpt-4o-mini
CHEAP_MODEL=gpt-4o-mini

# Path to the secured document corpus (only the PSEG-LI subset is ingested).
CORPUS_DIR=D:/projects/utility-rag/data
PROVIDER_FOLDER=PSEG Long Island

# Local artifact paths (relative to apps/backend/)
DB_URL=sqlite:///./utility.db
CHROMA_DIR=./chroma_db
DATA_DIR=./data
