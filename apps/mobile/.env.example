# Google sign-in — OAuth 2.0 client IDs.
#
# Copy this file to `.env`, fill in the IDs for the platforms you run on, and
# restart `npm start` (the config is read once at startup).
#
# Create the IDs at https://console.cloud.google.com/apis/credentials
# Full instructions: src/features/auth/README.md
#
# These are PUBLIC values. The flow uses PKCE and has no client secret — never
# put a client secret in this app.

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
